{
  "name": "between-lines",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8877",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "validate": "tsx scripts/validate.ts",
    "examples": "tsx scripts/prepare.ts",
    "prebuild": "npm run examples",
    "predev": "npm run examples",
    "pretest": "npm run examples",
    "postbuild": "tsx scripts/postbuild.ts",
    "source": "tsx scripts/source.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "^5.2.8",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.4",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
